# Results and outputs
terry/results/waveform_*/
# Track only the two deployment checkpoints, not waveform caches or reports.
!terry/results/waveform_cap_v1/
terry/results/waveform_cap_v1/*
!terry/results/waveform_cap_v1/cap8/
!terry/results/waveform_cap_v1/cap16/
terry/results/waveform_cap_v1/cap8/*
terry/results/waveform_cap_v1/cap16/*
!terry/results/waveform_cap_v1/cap8/best.pt
!terry/results/waveform_cap_v1/cap16/best.pt
# Only independent deployment checkpoints; leave caches/evaluations ignored.
!terry/results/waveform_subset_v1/
terry/results/waveform_subset_v1/*
!terry/results/waveform_subset_v1/cap2/
!terry/results/waveform_subset_v1/cap4/
!terry/results/waveform_subset_v1/cap6/
terry/results/waveform_subset_v1/cap2/*
terry/results/waveform_subset_v1/cap4/*
terry/results/waveform_subset_v1/cap6/*
!terry/results/waveform_subset_v1/cap2/best.pt
!terry/results/waveform_subset_v1/cap4/best.pt
!terry/results/waveform_subset_v1/cap6/best.pt
# Frontal retraining checkpoints only; raw EEG/caches stay excluded.
!terry/results/waveform_frontal_v1/
terry/results/waveform_frontal_v1/*
!terry/results/waveform_frontal_v1/cap2/
!terry/results/waveform_frontal_v1/cap4/
!terry/results/waveform_frontal_v1/cap6/
terry/results/waveform_frontal_v1/cap2/*
terry/results/waveform_frontal_v1/cap4/*
terry/results/waveform_frontal_v1/cap6/*
!terry/results/waveform_frontal_v1/cap2/best.pt
!terry/results/waveform_frontal_v1/cap4/best.pt
!terry/results/waveform_frontal_v1/cap6/best.pt
terry/backEnd/results/raw_data/
terry/backEnd/results/figures/*.png
terry/backEnd/results/figures/*.pdf

# Keep model files but ignore large datasets
!terry/backEnd/results/models/*.joblib
