SUNO_API_KEY=
SUNO_CALLBACK_SECRET=
# Used by scripts/generate_suno.py; loaded from backEnd/.env if not exported.
AISAASGO_API_KEY=
ACE_STEP_URL=http://127.0.0.1:8001
# Optional when the ACE-Step server requires authentication.
ACE_STEP_API_KEY=

# Web automatic EEG inference: set to 1 ONLY after verifying BrainFlow channel
# indices match config.hardware.yaml electrode order. This is not auto-validation.
TERRY_EEG_CHANNEL_MAP_CONFIRMED=0
# Experimental only: map 14 matching cap sites to the legacy model and estimate
# Fz from F3/F4, Cz from C3/C4. This is NOT a validated sleep classifier.
# Requires verified physical CH0-CH15 order and TERRY_EEG_CHANNEL_MAP_CONFIRMED=1.
TERRY_EEG_EXPERIMENTAL_16CH_MAPPING=0
