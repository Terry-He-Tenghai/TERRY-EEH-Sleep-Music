project:
  random_seed: 42

data:
  raw_dir: data/raw
  reference_dir: data/reference
  processed_dir: data/processed
  results_dir: results

channels:
  target:
    - Fp1
    - Fp2
    - F3
    - F4
    - F7
    - F8
    - Fz
    - C3
    - C4
    - Cz
    - T7
    - T8
    - P3
    - P4
    - O1
    - O2
  aliases:
    T7: T3
    T8: T4
  regions:
    frontal: [Fp1, Fp2, F3, F4, F7, F8, Fz]
    central: [C3, C4, Cz]
    temporal: [T7, T8]
    posterior: [P3, P4, O1, O2]

signal:
  target_sfreq_hz: 250
  # Hardware-requested EEG band: 5–50 Hz, with a separate 50 Hz mains notch.
  # These settings require model retraining/revalidation against matching data.
  highpass_hz: 5.0
  lowpass_hz: 50.0
  notch_frequency_hz: 50.0
  notch_quality_factor: 30.0
  line_frequency_hz: 50.0
  reference: average
  amplitude_reject_uv: 500.0
  robust_rms_z_threshold: 6.0

epoching:
  window_seconds: 6.0
  step_seconds: 3.0
  pre_n2_minutes: 20.0
  post_n2_minutes: 10.0
  stable_n2_seconds: 60.0
  slope_history_seconds: 60.0
  prediction_horizon_seconds: 300.0

bands:
  delta: [0.5, 4.0]
  theta: [4.0, 8.0]
  alpha: [8.0, 12.0]
  sigma: [12.0, 16.0]
  beta: [13.0, 30.0]
  high_beta: [20.0, 30.0]

quality:
  minimum_clean_channel_fraction: 0.75
  minimum_clean_window_fraction: 0.8

prediction:
  models: [logistic_regression, random_forest, svm]
  sustained_detection_seconds: 30.0
  probability_threshold: 0.5

realtime:
  schema_version: "1.0"
  baseline_seconds: 300.0
  input_unit: V
  require_target_sample_rate: true
  music_controller: adaptive

music:
  # Runtime generation/playback is opt-in; use local reviewed assets for experiments.
  enabled: false
  cache_file: results/music/cache.json
  approved_only: true
  player_backend: "null"
  engine: layered
  bpm: 60
  phrase_beats: 16
  result_source: poll
  poll_interval_seconds: 30
  poll_timeout_seconds: 360
  suno:
    base_url: "https://api.sunoapi.org"
    model: "V5_5"
    callback_url: "https://example.com/suno/callback"
  policy:
    decision_interval_seconds: 30.0
    confirmations_required: 2
    minimum_mode_dwell_seconds: 60.0
    minimum_signal_quality: 0.75
    n1_probability: 0.55
    n2_probability: 0.65
    future_n2_probability: 0.65
    relaxed_alpha_z: 0.5
    relaxed_beta_z: 0.0
    transition_theta_z: 0.5
    micro_arousal_beta_z: 2.0
    micro_arousal_w_probability: 0.45
    micro_arousal_cooldown_seconds: 120.0
    crossfade_seconds: 25.0
